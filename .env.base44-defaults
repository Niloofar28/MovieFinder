# Aurora Skincare — local development defaults for the Base44 sandbox.
#
# These values only make the app bootable locally. They are NOT third-party
# credentials. This file is listed FIRST in docker-compose.base44.yml so the
# platform-managed secret file (/run/base44/app.env) always wins.
#
# Behaviour with/without BASE44_PREVIEW_MODE is documented in README.md.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# SQLite file on the container volume (see docker-compose.base44.yml).
DATABASE_PATH=/app/data/aurora.db

# Fallback signing key for the session cookie. A generated development secret
# in /run/base44/app.env overrides this value automatically when present.
SESSION_SECRET=aurora-local-development-secret-replace-me

# Because the sandbox preview is served over an HTTPS proxy in front of plain
# HTTP inside the container, the session cookie is not marked Secure by
# default. Set COOKIE_SECURE=1 when serving the app behind HTTPS directly.
COOKIE_SECURE=0

# Bootstrap administrator account. Created once on first boot; the password is
# stored hashed and can be changed from the admin dashboard afterwards.
# CHANGE THESE before any real deployment.
ADMIN_EMAIL=admin@auroraskincare.example
ADMIN_PASSWORD=aurora-admin-demo
